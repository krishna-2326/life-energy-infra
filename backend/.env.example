# Express Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/life_energy_db
# Local MongoDB fallback example: mongodb://127.0.0.1:27017/life_energy_db
MONGO_URI=mongodb://127.0.0.1:27017/life_energy_db

# Security & JWT Authentication
JWT_SECRET=super_secret_jwt_key_life_energy_infra_2026_change_in_production
JWT_EXPIRES_IN=7d

# Default Admin Credentials (used during seed execution)
ADMIN_DEFAULT_EMAIL=admin@lifeenergyinfra.com
ADMIN_DEFAULT_PASSWORD=Admin@123456

# Company Contact Receiver Email
COMPANY_EMAIL=lifeenergyinfra@gmail.com

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Optional SMTP Email Configuration (Nodemailer)
# Leave blank if email notifications are not enabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
